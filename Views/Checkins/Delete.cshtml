@model CheckinLog.Models.Checkin

@{
    ViewData["Title"] = "Excluir Registro";

    // Função auxiliar para validar permissão
    bool UsuarioTemPermissao(string chave) => User.HasClaim("Permission", chave);
}

<div class="main-card shadow-sm p-4 mx-auto border-top border-danger border-5" style="max-width: 600px;">
    <div class="text-center mb-4">
        <h2 class="fw-bold text-danger">Confirmar Exclusão?</h2>
        <p class="text-muted">Você está prestes a remover permanentemente o registro de:</p>
        @if (Model != null)
        {
            <h4 class="fw-bold">@Model.Nome (@Model.Matricula)</h4>
        }
    </div>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <div class="d-flex justify-content-center gap-3">
            
            @if (UsuarioTemPermissao("btn_confirmar_exclusao"))
            {
                <button type="submit" class="btn btn-danger btn-lg px-5 shadow-sm">Sim, Excluir</button>
            }

            @if (UsuarioTemPermissao("btn_cancelar_exclusao"))
            {
                <a asp-action="Index" class="btn btn-light border btn-lg px-5">Cancelar</a>
            }
            
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
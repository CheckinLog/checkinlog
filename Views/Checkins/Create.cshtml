@model CheckinLog.Models.Checkin

@{
    ViewData["Title"] = "Auto Check-in";
    
    // Função auxiliar para validar permissão
    bool PodeVer(string chave) => User.HasClaim("Permission", chave);
}

<div class="main-card shadow-lg p-4 p-md-5 mx-auto" style="max-width: 900px;">
    <div class="text-center mb-5">
        <h1 class="fw-bold text-navy">BEM-VINDO</h1>
        <p class="text-muted">Por favor, preencha os dados abaixo para realizar seu check-in.</p>
    </div>

    <form asp-action="Create" enctype="multipart/form-data">
        <div class="row g-4">
            
            @if (PodeVer("campo_matricula"))
            {
                <div class="col-md-4">
                    <label asp-for="Matricula" class="form-label fw-bold">Matrícula</label>
                    <input asp-for="Matricula" class="form-control form-control-lg border-0 bg-light" placeholder="000000" />
                </div>
            }

            @if (PodeVer("campo_nome"))
            {
                <div class="col-md-8">
                    <label asp-for="Nome" class="form-label fw-bold">Nome Completo</label>
                    <input asp-for="Nome" class="form-control form-control-lg border-0 bg-light" placeholder="Digite seu nome completo" />
                </div>
            }

            @if (PodeVer("campo_email"))
            {
                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-bold">E-mail</label>
                    <input asp-for="Email" class="form-control form-control-lg border-0 bg-light" />
                </div>
            }

            @if (PodeVer("campo_funcao"))
            {
                <div class="col-md-3">
                    <label asp-for="Funcao" class="form-label fw-bold">Função</label>
                    <input asp-for="Funcao" class="form-control form-control-lg border-0 bg-light" />
                </div>
            }

            @if (PodeVer("campo_empresa"))
            {
                <div class="col-md-3">
                    <label asp-for="Empresa" class="form-label fw-bold">Empresa</label>
                    <input asp-for="Empresa" class="form-control form-control-lg border-0 bg-light" />
                </div>
            }

            <!-- Seção de Documentos -->
            @if (PodeVer("anexo_cnh"))
            {
                <div class="col-md-6 mt-4">
                    <label class="form-label fw-bold text-primary"><i class="bi bi-file-earmark-person"></i> Anexar CNH</label>
                    <input type="file" name="arquivoCNH" class="form-control border-0 bg-light" />
                </div>
            }

            @if (PodeVer("anexo_curso"))
            {
                <div class="col-md-6 mt-4">
                    <label class="form-label fw-bold text-primary"><i class="bi bi-shield-check"></i> Curso de Direção</label>
                    <input type="file" name="arquivoCurso" class="form-control border-0 bg-light" />
                </div>
            }

            <div class="col-12 mt-5">
                @if (PodeVer("btn_finalizar_checkin"))
                {
                    <button type="submit" class="btn btn-primary w-100 py-3 shadow">
                        <i class="bi bi-check2-circle"></i> FINALIZAR CHECK-IN
                    </button>
                }
                <a asp-action="Index" class="btn btn-link w-100 mt-2 text-muted">Cancelar</a>
            </div>
        </div>
    </form>
</div>
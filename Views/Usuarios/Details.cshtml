@model CheckinLog.Models.Usuario

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm" style="border-radius: 15px;">
                <div class="card-body p-5">
                    <h4 class="fw-bold mb-4 text-center" style="color: #2d3a4b;">
                        <i class="bi bi-shield-lock me-2"></i>DETALHES DO USUÁRIO
                    </h4>

                    <form asp-action="Save" method="post">
                        <!-- ID e NomeUsuario ocultos para garantir que o Save funcione sem alterar o login -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="NomeUsuario" />
                        <input type="hidden" asp-for="NivelAcesso" />

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase">Usuário</label>
                            <input type="text" class="form-control bg-light" value="@Model.NomeUsuario.ToUpper()" readonly />
                        </div>

                        <div class="mb-3">
                            <label class="form-label small fw-bold text-uppercase">Nível de Acesso</label>
                            <input type="text" class="form-control bg-light" value="Nível @Model.NivelAcesso" readonly />
                        </div>

                        <div class="mb-4">
                            <label class="form-label small fw-bold text-uppercase" style="color: #0d6efd;">Alterar Senha</label>
                            <input asp-for="Senha" type="password" class="form-control" style="height: 50px; border-radius: 10px; border: 2px solid #dee2e6;" required />
                            <small class="text-muted">Apenas a senha e o status podem ser alterados nesta tela.</small>
                        </div>

                        <div class="mb-4">
                            <div class="form-check form-switch">
                                <input asp-for="Ativo" class="form-check-input" type="checkbox" id="StatusAtivo">
                                <label class="form-check-label fw-bold" for="StatusAtivo">Usuário Ativo</label>
                            </div>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary fw-bold text-uppercase"
                                    style="height: 50px; border-radius: 10px; background: linear-gradient(90deg, #2DFF73 0%, #00FFEE 100%); border: none; color: #2d3a4b;">
                                SALVAR ALTERAÇÕES
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary fw-bold" style="border-radius: 10px;">VOLTAR PARA LISTA</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
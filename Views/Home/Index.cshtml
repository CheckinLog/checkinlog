@using CheckinLog.Extensions
@{
    ViewData["Title"] = "Início - CheckinLog";
    
    var frases = new[] {
        "A segurança no trânsito depende de cada um de nós. Boa viagem!",
        "A pressa passa, a segurança fica. Dirija com atenção.",
        "Sua família te espera. Vá com calma e segurança.",
        "O melhor motorista é aquele que respeita a vida.",
        "A paciência é a melhor companheira nas estradas.",
        "Grandes jornadas começam com um check-in seguro."
    };
    var fraseDoDia = frases[new Random().Next(frases.Length)];
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            
            <!-- FRASE DE REFLEXÃO -->
            <div class="mb-5 px-4">
                <i class="bi bi-quote fs-1 text-secondary opacity-25"></i>
                <h2 class="fst-italic text-secondary fw-light">
                    "@fraseDoDia"
                </h2>
                <hr class="w-25 mx-auto border-primary opacity-50">
            </div>

            @* CONTROLE DE ACESSO AO BOTÃO CENTRAL *@
            @if (User.HasPermission("btn_realizar_checkin")) 
            {
                <div class="card shadow-lg border-0 rounded-4 overflow-hidden mx-auto" style="max-width: 500px;">
                    <div class="card-body p-5">
                        <div class="mb-4">
                            <i class="bi bi-geo-alt-fill text-primary" style="font-size: 5rem;"></i>
                        </div>
                        
                        <h3 class="fw-bold mb-3">Check-in de Motorista</h3>
                        <p class="text-muted mb-4">
                            Clique no botão abaixo para iniciar o registro da sua viagem.
                        </p>

                        @* LINK APONTANDO PARA A VIEW CREATE DENTRO DE CHECKINS *@
                        <a asp-controller="Checkins" asp-action="Create" class="btn btn-primary btn-lg w-100 py-3 shadow border-0 hover-scale">
                            <i class="bi bi-plus-circle me-2"></i> REALIZAR CHECK-IN
                        </a>
                    </div>
                </div>
            }
            else 
            {
                <div class="alert alert-light border shadow-sm">
                    <i class="bi bi-info-circle me-2"></i> Utilize o menu superior para navegar nas funções administrativas.
                </div>
            }

        </div>
    </div>
</div>

@section Scripts {
    <style>
        .hover-scale { transition: transform 0.2s; }
        .hover-scale:hover { transform: scale(1.03); }
        h2.fst-italic { line-height: 1.4; }
    </style>
}
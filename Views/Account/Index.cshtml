@model CheckinLog.Models.LoginViewModel
@{
    Layout = null; // Tela de login geralmente não usa o menu superior
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Login - CheckinLog</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body { background-color: #f4f7f9; height: 100vh; display: flex; align-items: center; justify-content: center; }
        .login-card { width: 100%; max-width: 400px; padding: 40px; border: none; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.05); background: #fff; }
        .btn-primary { background-color: #00ADEE; border: none; border-radius: 10px; padding: 12px; font-weight: bold; }
        .form-control { border-radius: 10px; padding: 12px; border: 1px solid #dee2e6; }
    </style>
</head>
<body>
    <div class="login-card text-center">
        <!-- LOGO EDP -->
        <img src="~/images/logo.jpg" alt="Logo EDP" style="height: 60px; margin-bottom: 20px;">
        
        <h4 class="fw-bold mb-4" style="color: #2d3a4b;">Acesso ao Sistema</h4>

        <form asp-action="Login" method="post">
            <div class="mb-3 text-start">
                <label class="form-label small fw-bold">Usuário</label>
                <input asp-for="Usuario" class="form-control" placeholder="Digite seu usuário" required />
            </div>
            <div class="mb-4 text-start">
                <label class="form-label small fw-bold">Senha</label>
                <input asp-for="Senha" type="password" class="form-control" placeholder="••••••••" required />
            </div>

            @if (ViewBag.Erro != null)
            {
                <div class="alert alert-danger py-2 small">@ViewBag.Erro</div>
            }

            <button type="submit" class="btn btn-primary w-100 text-uppercase">Entrar</button>
        </form>
        
        <p class="mt-4 text-muted small">CheckinLog &copy; 2026</p>
    </div>
</body>
</html>